# Notion CRM — required for /work-with-us form submissions
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to the CRM - IMS data source if omitted
NOTION_DATA_SOURCE_ID=16087d70-5755-8364-992a-8781dc09e33c

# Google Analytics 4 — optional; banner + tracking only load when set
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Local dev: copy this file to .env.local and fill in your values.
# Firebase App Hosting: set Notion as secrets; add GA ID as a plain env var in apphosting.yaml or Console.
